    <groupId>com.workoss.zenoh</groupId>
    <artifactId>zenoh-jni</artifactId>
    <packaging>jar</packaging>
    <version>1.0.0-SNAPSHOT</version>
    <name>Zenoh JNI</name>
    <description>Zenoh native JNI bindings with dynamic library loading and storage plugin support</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <environmentVariables>
                        <ZENOH_BACKEND_FS_ROOT>./zenoh</ZENOH_BACKEND_FS_ROOT>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
