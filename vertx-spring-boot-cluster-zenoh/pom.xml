<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.workoss.boot.vertx</groupId>
        <artifactId>vertx-spring-boot-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vertx-spring-boot-cluster-zenoh</artifactId>
    <name>Vert.x Spring Boot Cluster Zenoh</name>
    <description>Vert.x ClusterManager backed by Zenoh with multi-tenant isolation</description>

    <dependencies>
        <dependency>
            <groupId>com.workoss.boot.vertx</groupId>
            <artifactId>vertx-spring-boot-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.workoss.zenoh</groupId>
            <artifactId>zenoh-jni</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Test-only, and deliberately not optional: the clustered-WebSocket E2E needs a real HTTP
          server on the same port as the upgrade. Keeping it in test scope preserves the shipping
          rule that cluster-zenoh and web-server do not depend on each other, so no Maven cycle.
        -->
        <dependency>
            <groupId>com.workoss.boot.vertx</groupId>
            <artifactId>vertx-spring-boot-web-server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
